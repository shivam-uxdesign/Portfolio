# Copy this file to .env.local and fill in your real keys.
# .env.local is gitignored — never commit real keys.

# Formspree — https://formspree.io — create a free form, paste its endpoint URL here.
# Contact messages will start posting to Formspree (dashboard + email) once this is set;
# until then the "Say Hello" button falls back to opening a mailto: draft.
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/your_form_id

# PostHog — https://posthog.com — create a free project, then Project Settings > Project API Key.
# Analytics (pageviews + cell navigation order) only turns on once this is set.
VITE_POSTHOG_KEY=phc_your_project_api_key
# Use https://eu.i.posthog.com instead if you chose the EU region when signing up.
VITE_POSTHOG_HOST=https://us.i.posthog.com
